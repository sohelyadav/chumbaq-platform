{
  "name": "@chumbaq/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:int": "jest --config jest.int.config.js",
    "seed": "ts-node src/scripts/seed.ts",
    "admin:grant": "ts-node src/scripts/super-admin.ts grant",
    "admin:revoke": "ts-node src/scripts/super-admin.ts revoke",
    "admin:passkeys-reset": "ts-node src/scripts/super-admin.ts passkeys-reset",
    "admin:factors-reset": "ts-node src/scripts/super-admin.ts factors-reset",
    "admin:password-reset-link": "ts-node src/scripts/super-admin.ts password-reset-link",
    "admin:staff-enrolment": "ts-node src/scripts/super-admin.ts staff-enrolment",
    "webhooks:seal-secrets": "ts-node src/scripts/seal-webhook-secrets.ts",
    "security:export-db-logs": "ts-node src/scripts/export-security-logs.ts",
    "start:worker": "node dist/worker",
    "dev:worker": "nest start --watch --entryFile worker",
    "start:admin-api": "node dist/main-admin",
    "dev:admin-api": "nest start --watch --entryFile main-admin",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate -d src/data-source.ts",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:run": "npm run typeorm -- migration:run -d src/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/data-source.ts",
    "migration:show": "npm run typeorm -- migration:show -d src/data-source.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/throttler": "^5.1.0",
    "@nestjs/typeorm": "^10.0.1",
    "@simplewebauthn/server": "^14.0.3",
    "@types/multer": "^2.1.0",
    "@types/qrcode": "^1.5.6",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.81.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "csv-parse": "^6.2.0",
    "geoip-lite": "^1.4.10",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "nanoid": "^3.3.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.19",
    "ua-parser-js": "^1.0.37"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.4.22",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/geoip-lite": "^1.4.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/ua-parser-js": "^0.7.39",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  }
}

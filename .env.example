# Chumbaq platform: local development settings.
# Copy into .env at the repo root and fill in the blanks. Generate each secret fresh;
# never reuse one between machines or environments.

# --- Database ---------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_NAME=chumbaq

# --- Redis ------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- API and web ------------------------------------------------------------
NODE_ENV=development
API_PORT=3010
API_BASE_URL=http://localhost:3010
SHORT_LINK_DOMAIN=localhost:3010
# The dashboard's address. Passkeys and account-email links are built from it.
APP_URL=https://localhost:5173
CORS_ORIGINS=https://localhost:5173
GEOIP_ENABLED=false

# --- Sign-in tokens ---------------------------------------------------------
# Two different values, each at least 32 characters: openssl rand -base64 64
# Changing either signs everyone out.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- Encryption keys --------------------------------------------------------
# Back these up apart from the database: losing one loses what it protects.
# TOTP secrets: openssl rand -base64 32
MFA_ENCRYPTION_KEY=
# Stored push, email, SMS and WhatsApp provider credentials: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=
# Mixpanel cohort credentials, at least 32 characters: openssl rand -hex 16
MIXPANEL_ENCRYPTION_KEY=

# --- Passkeys ---------------------------------------------------------------
PASSKEYS_FOR_TENANTS=true
# Defaults come from APP_URL; set these only to override.
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=Chumbaq
# WEBAUTHN_ORIGINS=https://localhost:5173
# Turn on once every super admin has two passkeys.
SUPER_ADMIN_PASSKEY_REQUIRED=false
SUPER_ADMIN_ALLOW_SYNCED_PASSKEYS=false

# --- Chumbaq's own account emails (Brevo) -----------------------------------
PLATFORM_BREVO_API_KEY=
PLATFORM_EMAIL_FROM=

# --- Optional limits (defaults shown) ---------------------------------------
# Hours a staff-requested second-factor reset waits before it runs.
FACTOR_RESET_DELAY_HOURS=72
# Days to keep sign-in and security events. At least 180 (CERT-In).
AUTH_EVENT_RETENTION_DAYS=365
# Longest a session can last, however often it is used. At least JWT_REFRESH_EXPIRATION.
SESSION_MAX_AGE=30d
